# PLANTILLA de las variables de las Edge Functions de pagos (Wompi SANDBOX).
# Este archivo contiene SOLO marcadores de posición; no hay ninguna llave real.
#
# Cómo usarlo:
#   1. Copia este archivo a `supabase/functions/.env` (ese archivo está en .gitignore:
#      NUNCA lo subas ni pegues sus valores en un chat o issue).
#   2. Reemplaza los valores de ejemplo por tus llaves de PRUEBA.
#   3. Sirve las funciones:  supabase functions serve --env-file supabase/functions/.env
#
# Las llaves de prueba se obtienen gratis en https://comercios.wompi.co → inicia sesión →
# «Desarrolladores» (ambiente de pruebas / Sandbox).
#
# GUARDIA SOLO-PRUEBA: si alguna llave no empieza por el prefijo de prueba o la URL de la API
# no es la del sandbox, TODAS las funciones responden 503 {"error":"SOLO_MODO_PRUEBA"}.
# No hay manera de apuntarlas a producción con esta configuración.

# Entorno: «sandbox» (Wompi de pruebas). «mock» solo lo usan las pruebas automáticas locales.
WOMPI_ENV=sandbox

# API de Wompi. En sandbox es siempre esta URL.
WOMPI_API_URL=https://sandbox.wompi.co/v1

# Página de pago de Wompi (Web Checkout). Siempre esta URL en sandbox.
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# Llave pública (empieza por pub_test_). Comercios Wompi → Desarrolladores → «Llaves del API».
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR

# Llave privada (prv_test_). Misma pantalla. Es SECRETA: solo vive en el servidor
# (consulta transacciones y crea reembolsos).
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR

# Secreto de eventos (test_events_). Comercios Wompi → Desarrolladores → «Secretos para
# integración técnica» → «Eventos». Verifica que los webhooks vengan de Wompi.
# En «URL de eventos» configura:  <URL pública de tus funciones>/pagos-webhook
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR

# Secreto de integridad (test_integrity_). Misma sección → «Integridad». Firma el monto
# para que nadie pueda alterarlo en la URL del checkout.
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR

# (Opcional) Prefijos de URL a los que Wompi puede devolver al viajero, separados por coma.
# Por defecto: la app web local (puertos 8080 y 3000) y la URL que intercepta el WebView
# de la app móvil (https://diverso.app/pago/resultado, nunca se carga).
# PAGOS_REDIRECT_ALLOWLIST=http://localhost:8080/,https://diverso.app/pago/resultado

# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY NO se definen aquí: el stack de
# Supabase (`supabase start` / `supabase functions serve`) los inyecta en las funciones.
