# Copiá este archivo a `.env` y completá. Expo solo expone al cliente las variables con prefijo EXPO_PUBLIC_.
# Supabase local (`supabase start`): la URL es la de abajo y la key es la "anon"/"publishable" que imprime `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=
